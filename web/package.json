{
  "name": "imgshrink-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "../scripts/build-wasm.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
